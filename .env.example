# Supabase (projet "img-ai" réutilisé pour ai-site-builder)
NEXT_PUBLIC_SUPABASE_URL=https://trtuhnzvkhtrshjarbgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_me8txTIaX8_spgABjh3g8w_ie2xq5VM

# Secret — jamais exposé au navigateur. Dashboard Supabase → Project
# Settings → API → service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Chiffre les tokens tiers (GitHub, Vercel...) avant stockage en base.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic — agent de génération de code
ANTHROPIC_API_KEY=
