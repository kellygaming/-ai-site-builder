# Supabase (projet "img-ai" réutilisé pour ai-site-builder)
NEXT_PUBLIC_SUPABASE_URL=https://trtuhnzvkhtrshjarbgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_me8txTIaX8_spgABjh3g8w_ie2xq5VM

# Secret — jamais exposé au navigateur. Dashboard Supabase → Project
# Settings → API → service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Chiffre les tokens tiers (GitHub, Vercel...) avant stockage en base.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Intégration Vercel (vercel.com/integrations/console)
VERCEL_INTEGRATION_SLUG=ai-site-builder
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Anthropic — agent de génération de code
ANTHROPIC_API_KEY=

# Requis UNIQUEMENT si la clé ci-dessus est "identity-linked" (liée à ton
# compte utilisateur et non à un workspace) : l'API renvoie sinon une 400
# "anthropic-workspace-id is required". Visible dans l'URL de la console
# Anthropic quand tu ouvres le workspace. Laisser vide avec une clé
# classique liée à un workspace.
ANTHROPIC_WORKSPACE_ID=

# Photos libres de droits pour les sites générés (pexels.com/api).
# Clé gratuite et instantanée. Sans elle, les sites sont générés sans photo.
PEXELS_API_KEY=
